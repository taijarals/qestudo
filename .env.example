# Configuração de Ambiente
# Mude para 'true' no Google AI Studio (Settings > Secrets) quando o Supabase estiver configurado
VITE_USE_API=true
VITE_API_URL=/api

# Configuração do PostgreSQL (Supabase)
# A string de conexão deve ser configurada via Secrets no AI Studio.
# O Prisma utilizará a feature 'multiSchema' para criar/gerenciar as tabelas 
# exclusivamente dentro do schema 'qestudo'.
#
# Formato esperado (fornecido pelo Supabase):
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/postgres?schema=qestudo&pgbouncer=true"
DATABASE_URL=postgresql://postgres.seu_projeto:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?schema=qestudo&pgbouncer=true
